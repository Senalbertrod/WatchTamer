      }
    },
    "💩 %lld poops! Flush now or your %@ will get sick!" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💩 ¡%lld cacas! Límpialas ya o tu %@ se enfermará."
