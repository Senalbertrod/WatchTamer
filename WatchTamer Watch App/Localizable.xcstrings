      }
    },
    "💩 Your %@ pooped! Time to flush." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💩 ¡Tu %@ hizo caca! Hora de limpiar."
          }
