      }
    },
    "💪 Your %@ is weak! Give it protein or train it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💪 ¡Tu %@ está débil! Dale proteína o entrénalo."
