        }
      }
    },
    "🥺 Your %@ is so lonely… Open WatchTamer today, or it will be gone forever!" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🥺 Tu %@ se siente muy solo… ¡Abre WatchTamer hoy o se irá para siempre!"
          }
        }
      }
    },
    "🥺 Your %@ misses you! Open WatchTamer in the next 2 days, or it will be gone forever." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🥺 ¡Tu %@ te extraña! Abre WatchTamer en los próximos 2 días o se irá para siempre."
          }
        }
      }
    }
  },
