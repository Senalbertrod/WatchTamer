    },
    "ZZZ... TAP 💡 TO WAKE" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZZZ... TOCA 💡 PARA DESPERTAR"
          }
        }
      }
    },
    "• MEAT = hunger. PROTEIN = strength.\n• Train by tapping fast or walking.\n• 5,000 steps a day = 1 training RESERVE (up to 4).\n• FLUSH poop. Skull = MEDICINE.\n• ! = your dino needs you.\n• Each battle uses 1 heart. Friends swap codes, then both tap BATTLE.\n• Each CPU win in a row makes the next rival stronger.\n• Rare eggs make stronger dinos.\n• Don't leave it alone for 2 weeks." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• CARNE = hambre. PROTEÍNA = fuerza.\n• Entrena tocando rápido o caminando.\n• 5,000 pasos al día = 1 RESERVA de entreno (hasta 4).\n• LIMPIA la caca. Calavera = MEDICINA.\n• ! = tu dino te necesita.\n• Cada batalla usa 1 corazón. Los amigos intercambian códigos y ambos tocan BATALLA.\n• Cada victoria seguida contra la CPU hace más fuerte al siguiente rival.\n• Los huevos raros dan dinos más fuertes.\n• No lo dejes solo por 2 semanas."
          }
        }
      }
    },
    "⚡ BATTLE!" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚡ ¡BATALLA!"
          }
        }
      }
    },
    "🍖 Your %@ is hungry! Feed it within 10 minutes." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🍖 ¡Tu %@ tiene hambre! Dale de comer en 10 minutos."
          }
        }
      }
    },
    "💀 Your %@ is sick! Give it medicine." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💀 ¡Tu %@ está enfermo! Dale medicina."
          }
        }
      }
    },
    "💩 %lld poops piling up. Flush them!" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💩 Se acumulan %lld cacas. ¡Límpialas!"
